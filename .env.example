# Minecraft Server Manager — environment configuration
# Copy this file to .env and adjust as needed. Never commit .env.

# Port the manager API/WebSocket listens on
HTTP_PORT=3000

# Host the manager binds to. 127.0.0.1 for local-only, 0.0.0.0 for LAN access
HTTP_HOST=0.0.0.0

# SQLite database location (file path on disk)
DATABASE_URL=file:./data/manager.db

# Root directory that holds all Minecraft server instances
SERVER_ROOT=./servers

# Default Java executable used when a server does not specify one
JAVA_PATH=java

# Minimum JVM heap (MB) applied unless the server instance overrides it
MEMORY_MIN_MB=1024

# Maximum JVM heap (MB) applied unless the server instance overrides it
MEMORY_MAX_MB=2048

# How often metrics are sampled and broadcast (ms)
METRICS_INTERVAL_MS=3000
# How long to wait for a graceful 'stop' before force-killing the process (ms)
SHUTDOWN_TIMEOUT_MS=15000
